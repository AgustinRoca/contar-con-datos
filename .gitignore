.DS_Store
.venv/
__pycache__/
*.pyc

# data/clean/ es reproducible corriendo scripts/clean/*.py sobre data/raw/,
# no hace falta versionarlo.
data/clean/

# data/raw/: se versionan los archivos de las fuentes que la pieza realmente
# usa (SAT, DEIS, EMSE, ENFR 2018, OMS, Censo, mapa mundial), datos y
# diccionarios/manuales por igual; todo lo demas (datasets explorados pero no
# usados en la pieza final: encoprac, sedronar, msal_snvs, eph, ipc) queda
# afuera del repo.
data/raw/*
!data/raw/SAT-SS-BU_2017-2024.csv
!data/raw/datos_sobre_defunciones_2024.csv
!data/raw/deis/
data/raw/deis/*
!data/raw/deis/defweb17.csv
!data/raw/deis/defweb18.csv
!data/raw/deis/defweb19.csv

!data/raw/deis/defweb21_0.csv
!data/raw/deis/defweb22_0.csv
!data/raw/deis/defweb23.csv
!data/raw/deis/descdef1.xlsx
!data/raw/emse/
data/raw/emse/*
!data/raw/emse/emse_datosabiertos.zip
!data/raw/emse/cuestionario_emse2018.pdf
!data/raw/emse/libro_codigos_emse2018.xlsx
!data/raw/emse/metodologia_emse2018.pdf
!data/raw/enfr/
data/raw/enfr/*
!data/raw/enfr/2018/
!data/raw/enfr/2018/ENFR 2018 - Base usuario.txt
